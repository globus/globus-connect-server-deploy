# syntax=docker/dockerfile:1

# family: el

############################################################################
# STAGE: bootstrap
#
# CentOS Stream 9 — built from scratch using almalinux:9 as bootstrap.
#
# CentOS Stream 9 is not available as an official Docker Hub image; this
# Dockerfile bootstraps it by installing centos-release into a minimal root
# filesystem using the AlmaLinux 9 package tools.
############################################################################
FROM almalinux:9 AS bootstrap

ARG _ROOT=/build-root

COPY <<'EOF' /yum/centos-9.repo
# reposdir points at a non-existent directory so that dnf does not load the
# bootstrap image's own repos (AlmaLinux) alongside the CentOS ones below.
# baseurl, not metalink: the metalink picks a mirror by the client's address, and
# a mirror that is out of sync fails repo_gpgcheck (seen through a proxy).
[main]
reposdir=/yum/repos.d

[centos-baseos]
name=CentOS Stream $releasever - BaseOS
baseurl=https://mirror.stream.centos.org/9-stream/BaseOS/$basearch/os/
gpgkey=file:///yum/RPM-GPG-KEY-CentOS
gpgcheck=1
repo_gpgcheck=1
enabled=1

[centos-appstream]
name=CentOS Stream $releasever - AppStream
baseurl=https://mirror.stream.centos.org/9-stream/AppStream/$basearch/os/
gpgkey=file:///yum/RPM-GPG-KEY-CentOS
gpgcheck=1
repo_gpgcheck=1
enabled=1
EOF

COPY <<'EOF' /yum/RPM-GPG-KEY-CentOS
# See https://centos.org/keys/

