mTfAxz4h
=agO/
-----END PGP PUBLIC KEY BLOCK-----
EOF

RUN <<EOF
set -e

mkdir -p ${_ROOT}/var/lib/rpm ${_ROOT}/dev
chmod 755 ${_ROOT}/dev
rpm --root ${_ROOT} --initdb

# Create minimal /dev entries to avoid postinstall script warnings
for dev in null urandom; do
    mknod ${_ROOT}/dev/${dev} c $(stat /dev/${dev} --format="%t %T")
    chmod 666 ${_ROOT}/dev/${dev}
done

yum -y -c /yum/centos-10.repo --releasever=10-stream \
    --installroot=${_ROOT} install centos-release yum

rm -f ${_ROOT}/dev/null ${_ROOT}/dev/urandom
EOF

############################################################################
# STAGE: base
#
# The starting image.
# No Docker Hub image exists for this distro: the root filesystem is
# built in the bootstrap stage above and copied in here.
############################################################################
FROM scratch AS base

COPY --from=bootstrap /build-root /

############################################################################
# STAGE: pre-repo
#
# Distro layers, before any Globus content; shared by every repo.  In order:
#   1. update the distro packages   2. install python3 + systemd
#   3. guard systemctl              4. cache barrier   5. install the systemctl mock
############################################################################
FROM base AS pre-repo

# --- 1. Distro package update -----------------------------------------
# Docker Hub images lag the distro's security updates, sometimes by months.
# _BASE_CACHEBUST re-runs this step (use it with 'docker build --pull').
ARG _BASE_CACHEBUST=0
RUN echo "_BASE_CACHEBUST=${_BASE_CACHEBUST}" \
 && dnf -y upgrade \
 && dnf clean all

# --- 2. systemctl mock prerequisites ----------------------------------
# EPEL is required for some GCS dependencies.  Installed via direct URL because
# several supported distros do not carry epel-release in their base repositories
# (Springdale 8/9, OracleLinux 10, RHEL UBI 8/9/10).  rpm -E %rhel expands to
# the distro major version (8, 9, or 10) at build time.
#
# dnf-plugins-core provides 'dnf config-manager', used by the globus-repo
# posttrans scriptlet and by the repo steps that switch repos.  It is only a
# soft dependency of epel-release and is not guaranteed to be pulled in
# automatically; installing it here ensures it is always present.
#
# python3 and systemd are installed now, at the current repo version, before the
# excludepkgs lock below prevents further updates.  GCS depends on systemd;
# without an explicit install here, dnf could pull in a newer version during the
# GCS install step and overwrite /bin/systemctl.
RUN dnf install -y \
        https://dl.fedoraproject.org/pub/epel/epel-release-latest-$(rpm -E %rhel).noarch.rpm \
        dnf-plugins-core \
        python3 \
        systemd \
 && dnf clean all

# --- 3. Protect /bin/systemctl from package updates -------------------
# Prevent dnf from updating the systemd package so that installing GCS cannot
# overwrite our mock symlink at /bin/systemctl.
RUN echo "excludepkgs=systemd" >> /etc/dnf/dnf.conf

# --- 4. CACHE BARRIER -------------------------------------------------
# Above: distro-provided, safe to cache.  Below: ours and Globus's, never cached.
# _CACHEBUST changes on every build, so every layer from here down always runs.
# The echo is deliberate: the build log shows whether this layer ran or was CACHED.
# To iterate with everything cached, pass a fixed --build-arg _CACHEBUST=<value>.
ARG _CACHEBUST=0
RUN echo "_CACHEBUST=${_CACHEBUST}"

# --- 5. Install systemctl mock ----------------------------------------
# Must be in place before GCS so the mock answers the systemctl calls the
# package's install scripts make.
# The excludepkgs lock above ensures dnf cannot overwrite /bin/systemctl.
COPY systemctl/systemctl_mock.py /gcs-deploy/systemctl-mock
RUN chmod +x /gcs-deploy/systemctl-mock \
 && ln -sf /gcs-deploy/systemctl-mock /bin/systemctl

############################################################################
# STAGE: repo-stable
#
# Sets up the stable GCS package repository.  GCS itself is installed
# later, in stage install.
############################################################################
FROM pre-repo AS repo-stable

# --- Globus repository ------------------------------------------------
RUN dnf install -y \
        https://downloads.globus.org/globus-connect-server/stable/installers/repo/rpm/globus-repo-latest.noarch.rpm \
 && dnf clean all

############################################################################
# STAGE: repo-other
#
# Sets up every repo that repo-stable does not: unstable, testing, the
# internal pre-stable, pre-unstable and pre-testing (they need the Globus
# VPN), or stable with its definitions taken from somewhere else.  A default
# build uses repo-stable, which is all that make export keeps for one.  Every
# combination here is one piece of shell, so this stage is busier.
#
# Two settings drive it.  REPO is the repo the packages come from.
# REPO_CONF is the repo whose globus-repo package supplies the definitions
# (the signing key and one stanza per repo); empty means the same as REPO.
# They differ when a new distro or key is only in a pre- repo's package:
# REPO=unstable REPO_CONF=pre-stable.  A pre- REPO derives its stanza from
# the public one with builds.globus.org/ in front of the URL, whatever
# REPO_CONF is.
#
# In order: 1. prerequisites (deb, suse), 2. install globus-repo, 3. switch to REPO.
# Step 3 disables the stable repo before it refreshes anything, so a
# non-stable build never reads the stable index.  The ARGs below are read
# only here.
############################################################################
FROM pre-repo AS repo-other

ARG REPO=stable
ARG REPO_CONF=

# --- 2. Globus repository ---------------------------------------------
RUN conf="${REPO_CONF:-${REPO}}" \
 && case "${conf}" in \
      stable|unstable|testing) \
        site=https://downloads.globus.org; channel=${conf} ;; \
      pre-stable|pre-unstable|pre-testing) \
        site=https://builds.globus.org/downloads.globus.org; channel=${conf#pre-} ;; \
      *) echo "REPO_CONF must be stable, unstable, testing, pre-stable, pre-unstable or pre-testing, not '${conf}'" >&2; exit 1 ;; \
    esac \
 && dnf install -y "${site}/globus-connect-server/${channel}/installers/repo/rpm/globus-repo-latest.noarch.rpm" \
 && dnf clean all

# --- 3. Switch to REPO ------------------------------------------------
# The package ships one stanza per repo: stable enabled, the others disabled.
# Filename is globbed: depending on which config-manager the package found, the
# stanza lands as globus-connect-server-5-<repo>-<el8|el9|el10>.repo.
# A pre- REPO derives its stanza from the public one the package defined, so
# gpgcheck, repo_gpgcheck, priority, the gpgkey file path and $releasever are
# inherited rather than reinvented.  The mirror path is literally
# 'builds.globus.org/' followed by the entire downloads.globus.org URL, so the
# rewrite is a pure prefix insertion.  Everything but stable then disables the
# stable repo.
RUN set -e \
 && channel=${REPO#pre-} \
 && case "${channel}" in \
      stable) name=Stable ;; \
      unstable) name=Unstable ;; \
      testing) name=Testing ;; \
      *) echo "REPO must be stable, unstable, testing, pre-stable, pre-unstable or pre-testing, not '${REPO}'" >&2; exit 1 ;; \
    esac \
 && if [ "${REPO}" != "${channel}" ]; then \
        src=$(ls /etc/yum.repos.d/globus-connect-server-5-${channel}-*.repo | head -1); \
        sed -e "s/^\[Globus-Connect-Server-5-${name}\]\$/[Globus-Connect-Server-5-Pre-${name}]/" \
            -e "s/^name=.*/name=Globus Connect Server 5 Pre-${name}/" \
            -e 's|https://downloads\.globus\.org/|https://builds.globus.org/downloads.globus.org/|' \
            "${src}" > /etc/yum.repos.d/globus-connect-server-5-${REPO}.repo; \
        name=Pre-${name}; \
    fi \
 && if [ "${REPO}" != stable ]; then \
        dnf config-manager --disable Globus-Connect-Server-5-Stable \
        && dnf config-manager --enable Globus-Connect-Server-5-${name}; \
    fi

############################################################################
# STAGE: install
#
# Installs GCS from the selected repo.
############################################################################
FROM repo-${_REPO_STAGE} AS install

# GCS_VERSION pins the GCS version, as 'globus-connect-server --version' prints
# it (5.4.99, 5.4.100-rc1).  Empty installs the newest in the repo.  The packages
# spell a pre-release 5.4.100~rc1, which is what the tr in the install step is for.
ARG GCS_PACKAGE=globus-connect-server54
ARG GCS_VERSION=

# --- Install GCS ------------------------------------------------------
RUN pkg="${GCS_PACKAGE}" \
 && if [ -n "${GCS_VERSION}" ]; then \
        pkg="${GCS_PACKAGE}-$(printf '%s' "${GCS_VERSION}" | tr - '~')"; \
    fi \
 && dnf install -y "${pkg}" \
 && dnf clean all

############################################################################
# STAGE: final
#
# The image users run: GCS installed, deployment files, ports, entrypoint.
# For a shell instead of GCS: docker run -it --entrypoint /bin/bash <image>
############################################################################
FROM install AS final

# --- GCS deployment files ---------------------------------------------
COPY entrypoint/entrypoint.sh /gcs-deploy/entrypoint.sh
COPY entrypoint/gcs_manager.service.d/ /gcs-deploy/gcs_manager.service.d/
COPY entrypoint/globus-oidc.service.d/ /gcs-deploy/globus-oidc.service.d/
RUN chmod +x /gcs-deploy/entrypoint.sh \
 && mkdir -p /etc/systemd/system \
 && ln -sf /gcs-deploy/gcs_manager.service.d \
           /etc/systemd/system/gcs_manager.service.d \
 && ln -sf /gcs-deploy/globus-oidc.service.d \
           /etc/systemd/system/globus-oidc.service.d

# 443        : GCS Manager API + HTTPS collection access
# 50000-51000: Default inbound data transfer port range
EXPOSE 443/tcp 50000-51000/tcp

ENTRYPOINT ["/gcs-deploy/entrypoint.sh"]
