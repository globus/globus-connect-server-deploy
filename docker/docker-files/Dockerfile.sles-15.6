FROM registry.suse.com/suse/sle15:15.6
# ── Prerequisites ─────────────────────────────────────────────────────────────
RUN zypper install -y curl \
 && zypper clean -a

# ── Globus repository ─────────────────────────────────────────────────────────
RUN curl -LOs https://downloads.globus.org/globus-connect-server/stable/installers/repo/rpm/globus-repo-latest.noarch.rpm \
 && rpm -i globus-repo-latest.noarch.rpm \
 && rm globus-repo-latest.noarch.rpm \
 && zypper --gpg-auto-import-keys refresh
# ── systemctl mock prerequisites ───────────────────────────────────────────────
# Install python311 and systemd now, at the current repo version, before the
# zypper addlock below prevents further updates.  python311 does not create
# /usr/bin/python3 automatically on SUSE 15; the symlink is added below.
RUN zypper install -y python311 systemd \
 && ln -sf /usr/bin/python3.11 /usr/bin/python3 \
 && zypper clean -a

# ── Protect /bin/systemctl from package updates ────────────────────────────────
# Prevent zypper from updating the systemd package so that installing GCS cannot
# overwrite our mock symlink at /bin/systemctl.
RUN zypper addlock systemd

# ── Install systemctl mock ─────────────────────────────────────────────────────
# Must be in place before GCS so the mock intercepts %post scriptlet calls.
# The zypper addlock above ensures zypper cannot overwrite /bin/systemctl.
COPY systemctl/systemctl_mock.py /gcs-deploy/systemctl-mock
RUN chmod +x /gcs-deploy/systemctl-mock \
 && ln -sf /gcs-deploy/systemctl-mock /bin/systemctl
# ── Install GCS ───────────────────────────────────────────────────────────────
RUN zypper install -y globus-connect-server54 \
 && zypper clean -a
# ── GCS deployment files ───────────────────────────────────────────────────────
COPY entrypoint/ /gcs-deploy/
RUN chmod +x /gcs-deploy/entrypoint.sh \
             /gcs-deploy/entrypoint-dev.sh \
 && mkdir -p /etc/systemd/system \
 && ln -sf /gcs-deploy/gcs_manager.service.d \
           /etc/systemd/system/gcs_manager.service.d \
 && ln -sf /gcs-deploy/globus-oidc.service.d \
           /etc/systemd/system/globus-oidc.service.d

# 443        : GCS Manager API + HTTPS collection access
# 50000-51000: Default inbound data transfer port range
EXPOSE 443/tcp 50000-51000/tcp

ENTRYPOINT ["/gcs-deploy/entrypoint.sh"]
