# syntax=docker/dockerfile:1
# Springdale Linux 9 — built from scratch using rockylinux:9-ubi as bootstrap.
#
# Springdale Linux (PUIAS) is not available as a Docker Hub image; this
# Dockerfile bootstraps it by installing springdale-release into a minimal root
# filesystem using the Rocky Linux 9 package tools.

FROM rockylinux/rockylinux:9-ubi AS bootstrap

ARG ROOT=/build-root

COPY <<'EOF' /yum/springdale.repo
[sdl-baseos]
name=Springdale core Base $releasever - $basearch
mirrorlist=http://springdale.princeton.edu/data/springdale/$releasever/$basearch/os/BaseOS/mirrorlist
enabled=1
gpgcheck=1
gpgkey=file:///yum/RPM-GPG-KEY-Springdale

[sdl-baseos-updates]
name=Springdale core Updates $releasever - $basearch
mirrorlist=http://springdale.princeton.edu/data/springdale/updates/$releasever/BaseOS/$basearch/mirrorlist
enabled=1
gpgcheck=1
gpgkey=file:///yum/RPM-GPG-KEY-Springdale
EOF

COPY <<'EOF' /yum/RPM-GPG-KEY-Springdale
