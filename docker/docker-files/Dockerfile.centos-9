# syntax=docker/dockerfile:1
# CentOS Stream 9 — built from scratch using almalinux:9 as bootstrap.
#
# CentOS Stream 9 is not available as an official Docker Hub image; this
# Dockerfile bootstraps it by installing centos-release into a minimal root
# filesystem using the AlmaLinux 9 package tools.

FROM almalinux:9 AS bootstrap

ARG ROOT=/build-root

COPY <<'EOF' /yum/centos-9.repo
[centos-baseos]
name=CentOS Stream $releasever - BaseOS
metalink=https://mirrors.centos.org/metalink?repo=centos-baseos-$stream&arch=$basearch&protocol=https,http
gpgkey=file:///yum/RPM-GPG-KEY-CentOS
gpgcheck=1
repo_gpgcheck=1
enabled=1

[centos-appstream]
name=CentOS Stream $releasever - AppStream
metalink=https://mirrors.centos.org/metalink?repo=centos-appstream-$stream&arch=$basearch&protocol=https,http
gpgkey=file:///yum/RPM-GPG-KEY-CentOS
gpgcheck=1
repo_gpgcheck=1
enabled=1
EOF

COPY <<'EOF' /yum/RPM-GPG-KEY-CentOS
# See https://centos.org/keys/

