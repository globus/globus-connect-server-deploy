# syntax=docker/dockerfile:1

# family: el

############################################################################
# LAYOUT
#
# The stages, top to bottom.  Details: docker-files/README.md.
#
#   base               the starting image   (differs per distro)
#   pre-repo           distro update, systemd guard, CACHE BARRIER, systemctl mock
#   repo-stable        sets up the stable repo     \ one of the two is built, chosen
#   repo-other         sets up any other repo      / by ARG _REPO_STAGE
#   install            installs ${GCS_PACKAGE} from that repo
#   final              deployment files, ports, entrypoint  (the image users run)
#
# Each stage is a banner, saying what the stage is for, then its FROM line.
# This ARG is read by FROM lines, so it must sit above the first one.
# scripts/build sets _REPO_STAGE (stable for a default build, other for the
# rest); make export removes it.  ARG REPO and ARG REPO_CONF belong to
# repo-other.
############################################################################
ARG _REPO_STAGE=other

############################################################################
# STAGE: bootstrap
#
# CentOS Stream 10 — built from scratch using almalinux:10 as bootstrap.
#
# CentOS Stream 10 is not available as an official Docker Hub image; this
# Dockerfile bootstraps it by installing centos-release into a minimal root
# filesystem using the AlmaLinux 10 package tools.
############################################################################
FROM almalinux:10 AS bootstrap

ARG _ROOT=/build-root

# almalinux:10 does not include gzip by default; needed for RPM operations
RUN dnf install -y gzip

COPY <<'EOF' /yum/centos-10.repo
# reposdir points at a non-existent directory so that dnf does not load the
# bootstrap image's own repos (AlmaLinux) alongside the CentOS ones below.
# baseurl, not metalink: the metalink picks a mirror by the client's address, and
# a mirror that is out of sync fails repo_gpgcheck (seen through a proxy).
[main]
reposdir=/yum/repos.d

[centos-baseos]
name=CentOS Stream $releasever - BaseOS
baseurl=https://mirror.stream.centos.org/10-stream/BaseOS/$basearch/os/
gpgkey=file:///yum/RPM-GPG-KEY-centosofficial-SHA256-CentOS-10
gpgcheck=1
repo_gpgcheck=1
enabled=1

[centos-appstream]
name=CentOS Stream $releasever - AppStream
baseurl=https://mirror.stream.centos.org/10-stream/AppStream/$basearch/os/
gpgkey=file:///yum/RPM-GPG-KEY-centosofficial-SHA256-CentOS-10
gpgcheck=1
repo_gpgcheck=1
enabled=1
EOF

COPY <<'EOF' /yum/RPM-GPG-KEY-centosofficial-SHA256-CentOS-10
# https://centos.org/keys/RPM-GPG-KEY-CentOS-Official-SHA256
-----BEGIN PGP PUBLIC KEY BLOCK-----
Version: GnuPG v2.0.22 (GNU/Linux)

mQINBFzMWxkBEADHrskpBgN9OphmhRkc7P/YrsAGSvvl7kfu+e9KAaU6f5MeAVyn
rIoM43syyGkgFyWgjZM8/rur7EMPY2yt+2q/1ZfLVCRn9856JqTIq0XRpDUe4nKQ
8BlA7wDVZoSDxUZkSuTIyExbDf0cpw89Tcf62Mxmi8jh74vRlPy1PgjWL5494b3X
5fxDidH4bqPZyxTBqPrUFuo+EfUVEqiGF94Ppq6ZUvrBGOVo1V1+Ifm9CGEK597c
aevcGc1RFlgxIgN84UpuDjPR9/zSndwJ7XsXYvZ6HXcKGagRKsfYDWGPkA5cOL/e
f+yObOnC43yPUvpggQ4KaNJ6+SMTZOKikM8yciyBwLqwrjo8FlJgkv8Vfag/2UR7
JINbyqHHoLUhQ2m6HXSwK4YjtwidF9EUkaBZWrrskYR3IRZLXlWqeOi/+ezYOW0m
