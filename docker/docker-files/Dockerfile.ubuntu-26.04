FROM ubuntu:26.04
# ── Prerequisites ─────────────────────────────────────────────────────────────
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y \
        curl \
 && rm -rf /var/lib/apt/lists/*

# ── Globus repository ─────────────────────────────────────────────────────────
RUN curl -LOs https://downloads.globus.org/globus-connect-server/stable/installers/repo/deb/globus-repo_latest_all.deb \
 && dpkg -i globus-repo_latest_all.deb \
 && rm globus-repo_latest_all.deb \
 && apt-get update \
 && rm -rf /var/lib/apt/lists/*
# ── systemctl mock prerequisites ───────────────────────────────────────────────
# Install python3 and systemd now, at the current repo version, before
# dpkg-divert locks /bin/systemctl in place.
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y \
        python3 \
        systemd \
 && rm -rf /var/lib/apt/lists/*

# ── Protect /bin/systemctl from package updates ────────────────────────────────
# dpkg-divert redirects any future dpkg write to /bin/systemctl.distrib,
# leaving our mock symlink intact when apt later installs or upgrades systemd.
RUN dpkg-divert --local --rename --add /bin/systemctl

# ── Install systemctl mock ─────────────────────────────────────────────────────
# Must be in place before GCS so the mock intercepts %post scriptlet calls.
COPY systemctl/systemctl_mock.py /gcs-deploy/systemctl-mock
RUN chmod +x /gcs-deploy/systemctl-mock \
 && ln -sf /gcs-deploy/systemctl-mock /bin/systemctl
# ── Install GCS ───────────────────────────────────────────────────────────────
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y globus-connect-server54 \
 && rm -rf /var/lib/apt/lists/*
# ── GCS deployment files ───────────────────────────────────────────────────────
COPY entrypoint/ /gcs-deploy/
RUN chmod +x /gcs-deploy/entrypoint.sh \
             /gcs-deploy/entrypoint-dev.sh \
 && mkdir -p /etc/systemd/system \
 && ln -sf /gcs-deploy/gcs_manager.service.d \
           /etc/systemd/system/gcs_manager.service.d \
 && ln -sf /gcs-deploy/globus-oidc.service.d \
           /etc/systemd/system/globus-oidc.service.d

# 443        : GCS Manager API + HTTPS collection access
# 50000-51000: Default inbound data transfer port range
EXPOSE 443/tcp 50000-51000/tcp

ENTRYPOINT ["/gcs-deploy/entrypoint.sh"]
