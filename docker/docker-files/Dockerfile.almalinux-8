# syntax=docker/dockerfile:1.3-labs

############### STAGE 1 - Prepare the image for GCS installation ###############
FROM almalinux:8

# Prereqs
RUN <<EOF
    # Ansible 2.12 will require python38 or newer
    dnf install -y coreutils-single gzip python39 sudo tar util-linux
EOF

